%% -*- mode: erlang -*-
%% Unless you know what you are doing, DO NOT edit manually!!
{VSN,
  [
   {"3.0.3",
    [{add_module,gen_rpc_exec_worker},
     {add_module,gen_rpc_exec_worker_sup},
     {load_module,gen_rpc_sup,brutal_purge,soft_purge,[]},
     {apply,{gen_rpc_sup,ensure_exec_worker_sup_started,[]}},
     {load_module,gen_rpc_acceptor,brutal_purge,soft_purge,[]}
    ]},
   %% e4.4.12 uses gen_rpc 3.0.1
   {<<"3.0.[1-2]">>,
    [{add_module,gen_rpc_exec_worker},
     {add_module,gen_rpc_exec_worker_sup},
     {load_module,gen_rpc_sup,brutal_purge,soft_purge,[]},
     {apply,{gen_rpc_sup,ensure_exec_worker_sup_started,[]}},
     {load_module,gen_rpc_acceptor,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_server,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_client,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_driver_ssl,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_driver_tcp,brutal_purge,soft_purge,[]}]},
   %% e4.4.11 uses gen_rpc 2.7.2, restart it as we have too many code change
   {<<".*">>, [{restart_application, gen_rpc}]}
  ],
  [{"3.0.3",
    [{load_module,gen_rpc_sup,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_acceptor,brutal_purge,soft_purge,[]},
     {delete_module,gen_rpc_exec_worker},
     {delete_module,gen_rpc_exec_worker_sup}
    ]},
   {<<"3.0.[1-2]">>,
    [{load_module,gen_rpc_sup,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_acceptor,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_server,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_client,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_driver_ssl,brutal_purge,soft_purge,[]},
     {load_module,gen_rpc_driver_tcp,brutal_purge,soft_purge,[]},
     {delete_module,gen_rpc_exec_worker},
     {delete_module,gen_rpc_exec_worker_sup}
    ]},
   {<<".*">>, [{restart_application, gen_rpc}]}
  ]
}.
